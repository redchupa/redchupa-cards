# Local development env (copy to .env.local; never commit real values)
# Used only by local dev tooling — NEVER consumed by the card bundle itself.

# URL of a *dev* Home Assistant instance you control (e.g. a separate test HA).
# Do NOT put your production HA URL here.
HA_DEV_URL=http://localhost:8123

# A long-lived access token for the dev HA above (rotate freely).
# Generate from User Profile → Long-Lived Access Tokens on the dev instance.
HA_DEV_TOKEN=YOUR_DEV_TOKEN_HERE
